# Copy to .env and fill in. The office reads .env on startup (real environment
# variables win over .env values); SWARM_ENV_FILE points at another file.

# Office port (default 4317). Avoid 4317/5317 (the live office) and 6300+N (floor previews).
SWARM_PORT=3000
# Office state and workspaces (default ~/.cubefarm). Keep it inside the repo for throwaway runs.
SWARM_HOME=./.swarm-home

# --- Custom Anthropic-compatible endpoint (e.g. a LiteLLM gateway on a VPS) ---
# Set both to run agents on the gateway instead of the Claude subscription login.
# Unset both: agents use the subscription, as before.
# SWARM_ANTHROPIC_BASE_URL=http://<your-vps>:3456
# SWARM_ANTHROPIC_AUTH_TOKEN=<litellm-master-key>

# Model agents ask for (default claude-opus-5-5). Must exist on the endpoint when set,
# e.g. claude-sonnet for the default claude-code-router aliases.
# SWARM_DEFAULT_MODEL=claude-sonnet

# Aliases Claude Code maps its models onto (defaults claude-sonnet/haiku/opus).
# SWARM_ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet
# SWARM_ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku
# SWARM_ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus
